# Copy to .env and adjust before deploying docker-compose.yml anywhere beyond a local machine.
# docker-compose reads .env automatically from this directory.

POSTGRES_USER=trustai_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trustaidb

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Consumed by rag-service and gateway-service (see application.yml in each module)
CORS_ALLOWED_ORIGINS=http://localhost:4200
